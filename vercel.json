{
  "framework": "vite",
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/retry-notifications",
      "schedule": "0 15 * * *"
    }
  ],
  "rewrites": [
    {
      "destination": "/index.html",
      "source": "/admin"
    },
    {
      "destination": "/index.html",
      "source": "/admin/:path*"
    }
  ]
}
