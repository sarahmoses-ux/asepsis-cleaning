# Server-only settings. Set these in your backend hosting environment (for example Render).
# Never use a VITE_ prefix for these secrets.
BOOKING_NOTIFICATIONS_ENABLED=false
# Email works independently. Enable SMS only after Twilio sender setup is complete.
BOOKING_SMS_ENABLED=false
SITE_URL=https://your-domain.example
RESEND_API_KEY=
BOOKING_FROM_EMAIL=Asepsis Bookings <bookings@your-verified-domain.example>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# Optional extra business alert recipients, comma-separated, including country codes.
# The existing +14055497722 always receives alerts too.
ADDITIONAL_SMS_RECIPIENTS=
# Use either MONGODB_URI or MONGO_URI; the app accepts both for compatibility.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/asepsis
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/asepsis
MONGODB_DB=asepsis
CRON_SECRET=

# Optional embedded card checkout. Leave off until the merchant account and webhook are ready.
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Public frontend build setting only: Render backend origin when hosted separately.
# Leave empty for local Vite proxy or same-origin hosting. Never put secrets here.
VITE_API_BASE_URL=
